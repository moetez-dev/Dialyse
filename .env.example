# Copy to .env and fill in values. Never commit .env.

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True

# Gmail / SMTP (ROTATE any previously committed app password)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Raspberry Pi / edge pipeline (header: X-Edge-Api-Key)
# Obligatoire : la valeur d'exemple ci-dessous est refusée par le serveur.
# Générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
EDGE_API_KEY=dev-edge-key-change-me
